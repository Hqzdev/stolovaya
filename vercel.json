{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npm ci --include=dev",
      "buildCommand": "npm run build"
    },
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "entrypoint": "src/main.ts",
      "installCommand": "cd ../.. && npm ci --include=dev",
      "buildCommand": "npm run build",
      "functions": {
        "src/main.ts": {
          "includeFiles": "migrations/**"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
