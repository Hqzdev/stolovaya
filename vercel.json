{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npm ci --include=dev",
      "buildCommand": "npm run build"
    },
    "api": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "apps/api/Dockerfile"
    }
  },
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
